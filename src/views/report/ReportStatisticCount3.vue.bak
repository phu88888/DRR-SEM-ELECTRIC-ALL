              อัตราการไหลของปริมาณจราจร
            </span>
          </foreignObject>
          <foreignObject
            x="500"
            y="180"
            width="100%"
            height="100%"
            color="#000000"
            style=" text-shadow: 2px 2px #fff;"
          >
            <span style="text-align:left; font-weight: 700; font-size: 50px;">
              70{{ SpeedAVG }}
            </span>
            <span
              style="text-align:center; font-weight: 600; font-size: 40px;"
            >
              PCU/ชม.
            </span>
          </foreignObject>
        </svg>
      </b-col>
      <b-col
        lg="4"
        md="4"
      />
    </b-row>
  </div>
</template>

<script>
import {
  BRow, BCol, BCard,
  // BPopover,
} from 'bootstrap-vue'
import axios from '@axios'

export default {
  components: {
    BRow,
    BCol,
    BCard,
    // BImg,
    // BPopover,
  },
  data() {
    return {
      Total: '',
      Type_Max: '',
      Type: '',
      Speed_Max: '',
      Speed85: 0,
      SpeedAVG: 0,
    }
  },
  beforeDestroy() {
    window.removeEventListener('resize', this.isSmallScreen)
    clearInterval(this.interval)
  },
  mounted() {
    this.getSumCount()
    this.getFormula()
    window.addEventListener('resize', this.isSmallScreen)
    this.interval = setInterval(() => {
      window.addEventListener('resize', this.isSmallScreen)
      this.getSumCount()
      this.getFormula()
    }, 300000)
  },
  methods: {
    isSmallScreen() {
      return window.innerWidth <= 850
    },
    getFormula() {
      axios
        .post('/getFormulaCountDetail-All', { wid: this.$route.query.wid })
        .then(response => {
          // eslint-disable-next-line prefer-destructuring
          this.Speed85 = response.data[0].Speed85
          this.SpeedAVG = response.data[0].SpeedAVG
        })
        .catch(error => {
          console.log(error)
        })
    },
    getSumCount() {
      axios
        .post('/getSumCountDetail-All', { wid: this.$route.query.wid })
        .then(response => {
          this.Total = response.data[0].Total.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',')
          this.Type_Max = response.data[0].Type_Max.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',')
          this.Speed_Max = response.data[0].Speed_Max.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',')

          if (response.data[0].Type_Max === response.data[0].Bike && response.data[0].Type_Max !== 0) {
            this.Type = 'จักรยานยนต์'
          } else if (response.data[0].Type_Max === response.data[0].Car && response.data[0].Type_Max !== 0) {
            this.Type = 'รถยนต์'
          } else if (response.data[0].Type_Max === response.data[0].Truck && response.data[0].Type_Max !== 0) {
            this.Type = 'รถบรรทุก'
          } else if (response.data[0].Type_Max === response.data[0].Bus && response.data[0].Type_Max !== 0) {
            this.Type = 'รถบัส'
          } else if (response.data[0].Type_Max === response.data[0].Taxi && response.data[0].Type_Max !== 0) {
            this.Type = 'รถแท็กซี่'
          } else if (response.data[0].Type_Max === response.data[0].Pickup && response.data[0].Type_Max !== 0) {
            this.Type = 'รถกระบะ'
          } else if (response.data[0].Type_Max === response.data[0].Trailer && response.data[0].Type_Max !== 0) {
            this.Type = 'รถพ่วง'
          }
        })
        .catch(error => {
          console.log(error)
        })
    },
  },
}
</script>

