        // },
      ],
      userData: JSON.parse(localStorage.getItem('userData')),
      items: [],
      itemsPCU: [],
    }
  },
  computed: {
    sortOptions() {
      // Create an options list from our fields
      return this.fields
        .filter(f => f.sortable)
        .map(f => ({ text: f.label, value: f.key }))
    },
  },
  mounted() {
    this.tableCount()
    this.tableCountPCU()
  },
  methods: {
    tableCount() {
      axios
        .post('/get-Count-Daily-All', { location_id: this.$route.query.location_id })
        .then(response => {
          this.items = response.data
          this.totalRows = response.data.length
          this.date_time = response.data[0].date_time
        })
        .catch(error => {
          console.log(error)
        })
    },

    showImg(img) {
      this.$swal({
        imageUrl: img,
        imageAlt: 'Custom image',
        width: 800,
        background: 'hsla(0, 100%, 100%, 0)',
        showCancelButton: false,
        showConfirmButton: false,
        showCloseButton: true,
      })
    },
    tableCountPCU() {
      axios
        .post('/get-Count-Daily-PCU-All', { location_id: this.$route.query.location_id })
        .then(response => {
          this.itemsPCU = response.data
          this.totalRows = response.data.length
        })
        .catch(error => {
          console.log(error)
        })
    },

    generatePDF() {
      this.$refs.html2Pdf.generatePdf()
    },
  },
}
